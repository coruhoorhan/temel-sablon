# Dependencies
node_modules/
.pnpm-store/

# Build
dist/
build/
coverage/
*.tsbuildinfo

# Env — gitleaks + ruleset yakalar, hiçbir zaman commit'e girmez
.env
.env.*
!.env.example

# Keys/secrets — gitleaks'e ikinci katman
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.secret

# Logs
*.log
npm-debug.log*

# Editor/OS
.vscode/
.idea/
.DS_Store

# Tooling
.archcore/tmp/

# Midas hafıza — SQLite veritabanı + yerel config asla commit'e girmez.
# Şablon (.template) ve policy (.md) commit'lenir; memory ve config düzenlenebilir durumdur.
.midas/memory.sqlite3
.midas/config.yaml
.midas/*.db
.midas/*.db-*
.midas/audit*.log

# AGT — template'ten üretilen gerçek policy/fixture'lar commit'e girmez (setup.sh üretir).
.agt/policy.yaml
.agt/fixtures/policy.test.yaml
