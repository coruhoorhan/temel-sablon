# Bu dosyayı commit'le — gerçek değerler asla buraya!
# Kopyala: cp .env.example .env (yerel, gitignore'da)

# API kök adresi (örnek)
VITE_API_URL=https://api.example.com

# Log seviyesi: debug | info | warn | error
LOG_LEVEL=info

# Zorunlu değişkenler: deploy/kullanım öncesi doldur
# SECRET_MASTER_KEY=
# DATABASE_URL=
